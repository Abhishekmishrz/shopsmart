PORT=5050
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shopsmart
JWT_SECRET=replace-with-a-long-random-string
OPENAI_API_KEY=sk-...
CLIENT_URL=http://localhost:5173

